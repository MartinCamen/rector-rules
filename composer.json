{
  "name": "martincamen/rector.rules",
  "description": "Rules for Rector",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "rector",
    "php",
    "automation"
  ],
  "authors": [
    {
      "name": "Martin Camen",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "rector/rector": "^2.3"
  },
  "require-dev": {
    "laravel/pint": "^1.0",
    "pestphp/pest": "^4.7",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^12.0",
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "psr-4": {
      "MartinCamen\\RectorRules\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MartinCamen\\RectorRules\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "pint": "vendor/bin/pint --test",
    "pint-fix": "vendor/bin/pint",
    "analyse": "vendor/bin/phpstan analyse",
    "test": "vendor/bin/phpunit",
    "rector": "vendor/bin/rector process --dry-run",
    "rector-fix": "vendor/bin/rector process",
    "check": [
      "@analyse",
      "@test",
      "@pint",
      "@rector"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable"
}
